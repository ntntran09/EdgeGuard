PORT=3000
# Optional override when the MQTT-selected LAN address is not reachable by ESP32.
BACKEND_PUBLIC_URL=
FOMO_HTTP_BASE_URL=

# MQTT broker connection
MQTT_ENABLED=true
MQTT_PROTOCOL=mqtt
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
# MQTT_URL=mqtt://broker.hivemq.com:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Topic identity
MQTT_DEVICE_ID=device_001
MQTT_TOPIC_BASE=/EdgeGuard/device_001

# Local image storage
IMAGE_STORAGE_DIR=./data/images
MAX_IMAGE_BYTES=5242880

# Supabase Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_IMAGE_BUCKET=event-images

# Telegram Notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AWS Rekognition (face registration & recognition)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REKOGNITION_COLLECTION_ID=edgeguard-faces
